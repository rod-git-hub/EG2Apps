# Supply-chain policy. Review any change to this file.

# Record exact versions in package.json, never ranges like ^1.2.3
save-exact=true

# Never run package install scripts (preinstall/install/postinstall).
ignore-scripts=true

# Only install versions published at least this many days ago:
# 2 while developing; 7 for anything shipped (checked before a release: npm run check:release).
min-release-age=2

# Only install from the npm registry: no git repositories, no tarball URLs
allow-git=none
allow-remote=none

# Refuse to install if the Node version doesn't match package.json "engines"
engine-strict=true

# Quieter output
fund=false
